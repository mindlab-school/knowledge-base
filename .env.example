OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb
BACKEND_URL=http://localhost:8000
AGENT_MODEL=anthropic/claude-haiku-4.5
OR_MODEL_VARIANT=              # empty | :exacto (tool-calling accuracy) | :nitro
AGENT_EFFORT=                  # only for models with adaptive thinking (Sonnet 5); empty for Haiku
EXTRACTION_MODEL=anthropic/claude-haiku-4.5
EMBED_BACKEND=local            # local (voyage-4-nano on CPU) | openrouter
EMBED_MODEL=voyage-4-nano
EMBED_DIM=1024                 # must match halfvec(N) in the schema
PROMPT_CACHE=auto              # auto: cache_control only if prefix >= CACHE_MIN_TOKENS
CACHE_MIN_TOKENS=4096          # Anthropic minimum for Haiku 4.5
FACTS_BLOCK_LIMIT=4000         # characters
OR_ALLOW_FALLBACKS=true
OR_SITE_URL=                   # HTTP-Referer header, optional
OR_APP_NAME=kb-agent           # X-Title header, optional
OR_MONTHLY_LIMIT=20            # soft spend limit, USD
